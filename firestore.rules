rules_version = '2';

/* モンスター収集ゲームのFirestoreルール。
   Firebaseコンソール → Firestore Database → ルール に貼り付けるか、
   firebase deploy --only firestore:rules で反映する。 */
service cloud.firestore {
  match /databases/{database}/documents {

    // 公開プロフィール(フレンド一覧・PVPの相手表示用)。読めるのはログイン済みの人、書けるのは本人だけ
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // セーブデータ。本人以外は読み書きできない
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // フレンドコード → uid の対応表。自分のuidで新規作成だけ許可し、他人のコードは奪えない
    match /playerIds/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
