rules_version = '2';

/* モンスター収集ゲームのFirestoreルール。
   Firebaseコンソール → Firestore Database → ルール に貼り付けるか、
   firebase deploy --only firestore:rules で反映する。 */
service cloud.firestore {
  match /databases/{database}/documents {

    // 公開プロフィール(フレンド一覧・PVPの相手表示用)。読めるのはログイン済みの人、書けるのは本人だけ。
    // allow read は get だけでなく list(コレクションクエリ)も許可するので、PVPのランダム
    // 対戦相手取得(players コレクションへの where/orderBy/limit クエリ)もこのルールでそのまま動く。
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // フレンドポイントの受け取り箱。他人(uid本人以外)がここに書き込める唯一の場所だが、
      // 送信者は自分のuidしか名乗れず、reasonごとに金額が固定(index.htmlのFRIEND_POINT_PER_SEND=10、
      // FRIEND_POINT_PER_BORROW_USE=5と完全一致する場合のみ)なので、任意の値を送りつける穴にはならない。
      // 'send' はフレンド画面の「ポイントを送る」、'borrow' はお助けキャラを借りて
      // クエストで使った時の自動付与(貸した側が受け取る)。
      // 受け取った本人だけが読める/消せる(=受け取り確認して自分のポイントに加算)。
      match /gifts/{giftId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && (
            (request.resource.data.reason == 'send' && request.resource.data.amount == 10) ||
            (request.resource.data.reason == 'borrow' && request.resource.data.amount == 5)
          );
        allow update: if false;
      }

      // 「自分をフレンドに追加した人」の一覧。ドキュメントIDは追加した側のuid。
      // 追加した本人が自分のuidの場所にだけ作成/更新でき(なりすまし不可)、
      // 持ち主(uid)だけが読める。持ち主・追加した本人どちらも削除できる
      // (持ち主は「フレンドを返す」で処理済みとして消す、追加した本人は取り消しに使える)。
      match /incoming/{fromUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == fromUid;
        allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == fromUid);
      }
    }

    // セーブデータ。本人以外は読み書きできない
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // アンケートの回答(α0.5〜)。surveys/{アンケートのid}/answers/{uid} に本人が1回だけ作れる。
    // プレイヤーからは読めない・書き換えられない(答えは Firebase コンソールか tools/survey_export.js で読む)
    match /surveys/{surveyId}/answers/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read, update, delete: if false;
    }

    // 通報(α0.5.002〜)。reports/{自動ID} に、ログインしている本人が自分のuidで作るだけ。
    // プレイヤーからは読めない・書き換えられない・消せない(運営が Firebase コンソールか tools/report_export.js で読む)。
    // 項目と文字数の上限はクライアント(index.html の buildReportDoc)と同じ。
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['reporter', 'target', 'targetPlayerId', 'reason', 'note', 'snapshot', 'at', 'version'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.target.size() > 0 && request.resource.data.target.size() <= 128
        && request.resource.data.target != request.auth.uid
        && request.resource.data.targetPlayerId is string && request.resource.data.targetPlayerId.size() <= 20
        && request.resource.data.reason in ['name', 'nick', 'bio', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 100
        && request.resource.data.snapshot is map
        && request.resource.data.snapshot.keys().hasOnly(['name', 'bio', 'monsters'])
        && request.resource.data.snapshot.name is string && request.resource.data.snapshot.name.size() <= 20
        && request.resource.data.snapshot.bio is string && request.resource.data.snapshot.bio.size() <= 100
        && request.resource.data.snapshot.monsters is string && request.resource.data.snapshot.monsters.size() <= 200
        && request.resource.data.at is number
        && request.resource.data.version is string && request.resource.data.version.size() <= 20;
      allow read, update, delete: if false;
    }

    // 運営の対処(α0.5.002〜)。運営がコンソールで moderation/{uid} に
    // { resetName: true, resetBio: true, resetNicks: true, at: <ミリ秒の数値> } などを書く(コンソールはルールを通らない)。
    // 本人だけ読める(次にログインしたとき、at が前回より新しければ該当を初期に戻す)。誰も書けない。
    match /moderation/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // フレンドコード → uid の対応表。自分のuidで新規作成だけ許可し、他人のコードは奪えない
    match /playerIds/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
